---
/** Страница юридического документа: короткая шапка, текст, подвал. Текст — от юриста заказчика. */
import Base from '../layouts/Base.astro';
import { getContent } from '../content';
import logo from '../assets/logo/umbrellacorp-logo-on-dark.svg';

interface Props { doc: 'privacy' | 'terms' }
const { doc } = Astro.props;
const home = getContent(Astro.currentLocale);
const l = home.ui.legal;
const title = doc === 'privacy' ? l.privacyTitle : l.termsTitle;
const placeholder = doc === 'privacy' ? l.privacyPlaceholder : l.termsPlaceholder;
const { ui } = home;
// переключатель языка ведёт на этот же документ на другом языке
const path = Astro.url.pathname;
const langHref = home.locale === 'en' ? path.replace(/^\/en(\/|$)/, '/') : `/en${path}`;
---
<Base title={`${title} — Umbrella AI`}>
  <header class="site-header legal-header">
    <div class="container site-header__row">
      <a href={home.links.home} class="site-header__logo" aria-label={home.header.homeLabel}>
        <img src={logo.src} width="247" height="26" alt="Umbrella AI" />
      </a>
      <div class="legal-header__actions">
        <div class="lang" role="group" aria-label={ui.lang.aria}>
          <span class="lang__opt is-active" aria-current="true">{ui.lang.current}</span>
          <a class="lang__opt" href={langHref} hreflang={ui.lang.other.lang} lang={ui.lang.other.lang} title={ui.lang.other.title}>{ui.lang.other.label}</a>
        </div>
        <a class="btn btn--ghost btn--sm" href={home.links.home}>{l.back}</a>
      </div>
    </div>
  </header>
  <main id="main" class="legal">
    <div class="container legal__inner">
      <h1 class="h2">{title}</h1>
      <p class="ph ph--light legal__ph">{placeholder}</p>
    </div>
  </main>
</Base>

<style>
  .legal { background: var(--c5); color: var(--c1); padding-block: var(--sec-pad); min-height: 70vh; }
  .legal__inner { display: flex; flex-direction: column; gap: 32px; max-width: 880px; }
  .legal__ph { white-space: normal; padding: 16px 20px; font-size: 16px; line-height: 1.5; }
</style>
