---
/** «01 — Проблема»: бенто из четырёх карточек, в каждой — мини-сцена хаоса (иллюстрации, aria-hidden).
    Тексты и данные сцен — home.problem (src/content/home*.ts). Стили — блок «Проблема» в src/styles/problem.css. */
import { getContent } from '../content';
import Icon from './Icon.astro';
import Lines from './Lines.astro';
import '../styles/problem.css';

const home = getContent(Astro.currentLocale);
const s = home.problem;
const sc = s.scenes;
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="section bg-light on-light" aria-labelledby="problem-title">
  <div class="container">
    <div class="sec-head">
      <div class="sec-head__title" data-reveal>
        <div class="eyebrow">{s.label}</div>
        <h2 class="h2" id="problem-title"><Lines text={s.title} desktopOnly /></h2>
      </div>
    </div>

    <div class="pb">
      <!-- 01 — счета в мессенджерах -->
      <article class="pb-card pb-card--chat" data-anim>
        <div class="pb-scene" aria-hidden="true">
          <div class="chat">
            <div class="chat__bar">
              <span class="chat__ava"><Icon name="chat" size={16} stroke={1.8} /></span>
              <span class="chat__app">{sc.chat.app}</span>
              <span class="chat__unread">{sc.chat.unread}</span>
            </div>
            <div class="chat__msg">{sc.chat.question}</div>
            <div class="chat__status"><span class="pulse"></span>{sc.chat.status}</div>
          </div>
        </div>
        <div class="pb-card__text">
          <span class="pb-card__num">{num(0)}</span>
          <h3>{s.cards[0].title}</h3>
          <p>{s.cards[0].text}</p>
        </div>
      </article>

      <!-- 02 — сводки вручную -->
      <article class="pb-card pb-card--sheet pb-card--dark" data-anim>
        <div class="pb-scene" aria-hidden="true">
          <div class="sheet">
            <div class="sheet__file"><span class="sheet__xls">X</span>{sc.sheet.file}</div>
            <div class="sheet__label">{sc.sheet.label}</div>
            <div class="sheet__value">{sc.sheet.value}</div>
            <div class="sheet__stale"><span class="pulse"></span>{sc.sheet.stale}</div>
          </div>
        </div>
        <div class="pb-card__text">
          <span class="pb-card__num">{num(1)}</span>
          <h3>{s.cards[1].title}</h3>
          <p>{s.cards[1].text}</p>
        </div>
      </article>

      <!-- 03 — у каждого юрлица свои порядки -->
      <article class="pb-card pb-card--ent pb-card--dark" data-anim>
        <div class="pb-scene" aria-hidden="true">
          <div class="ent">
            {sc.entities.items.map((name, i) => (
              <div class="ent__row" style={`--c:${i}`}>
                <span class="ent__name">{name}</span>
                <span class="ent__route">
                  {Array.from({ length: sc.entities.steps[i] }, (_, k) => <i style={`--k:${k}`}></i>)}
                </span>
              </div>
            ))}
            <div class="ent__note"><span>≠</span>{sc.entities.note}</div>
          </div>
        </div>
        <div class="pb-card__text">
          <span class="pb-card__num">{num(2)}</span>
          <h3>{s.cards[2].title}</h3>
          <p>{s.cards[2].text}</p>
        </div>
      </article>

      <!-- 04 — нет единой картины по людям -->
      <article class="pb-card pb-card--people" data-anim>
        <div class="pb-scene" aria-hidden="true">
          <div class="orbit">
            <div class="orbit__apps">
              {sc.people.apps.map((a, i) => <span class="orbit__app" style={`--k:${i}`}>{a}</span>)}
            </div>
            <div class="orbit__q">{sc.people.question}</div>
          </div>
        </div>
        <div class="pb-card__text">
          <span class="pb-card__num">{num(3)}</span>
          <h3>{s.cards[3].title}</h3>
          <p>{s.cards[3].text}</p>
        </div>
      </article>
    </div>

    <a class="pb-cta" href={s.solveLink.href} data-reveal>
      <span class="pb-cta__x" aria-hidden="true"><Icon name="check" size={18} stroke={2.2} /></span>
      <span class="pb-cta__text">{s.cta}</span>
      <span class="pb-cta__link">{s.solveLink.label}<Icon name="arrow" size={18} stroke={1.8} /></span>
    </a>
  </div>
</section>
