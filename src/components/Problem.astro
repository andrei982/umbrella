---
/** «01 — Проблема»: «хаос → порядок». Слева — четыре проблемы, справа — тёмная сцена с обрывками
    чатов, таблиц и сервисов (иллюстрация, aria-hidden). При прокрутке подсвечивается проблема за проблемой,
    затем обрывки слетаются в знак X (src/scripts/problem-motion.ts). Без JS и при reduced-motion — статичный хаос.
    Тексты — home.problem (src/content/home*.ts), стили — src/styles/problem.css. */
import { getContent } from '../content';
import Icon from './Icon.astro';
import Lines from './Lines.astro';
import xMint from '../assets/logo/umbrellacorp-x-mint.svg';
import '../styles/problem.css';

const home = getContent(Astro.currentLocale);
const s = home.problem;
const num = (i: number) => String(i + 1).padStart(2, '0');
// раскладка обрывков: [x %, y %, наклон°] — по ряду на проблему; x — доля и ширины сцены, и ширины плашки, так что край не вылезает
const POS: [number, number, number][] = [
  [8, 12, -4], [64, 7, 9], [94, 21, 3],
  [4, 35, 5], [56, 40, -5], [96, 47, -2],
  [6, 61, 4], [46, 67, -4], [94, 73, 6],
  [12, 87, -3], [56, 93, 4], [94, 89, -6],
];
---
<section class="section bg-light on-light" aria-labelledby="problem-title">
  <div class="container">
    <div class="sec-head">
      <div class="sec-head__title" data-reveal>
        <div class="eyebrow">{s.label}</div>
        <h2 class="h2" id="problem-title"><Lines text={s.title} desktopOnly /></h2>
      </div>
    </div>

    <div class="chaos" data-chaos>
      <ol class="chaos__list">
        {s.cards.map((c, i) => (
          <li class="chaos__item">
            <span class="chaos__num">{num(i)}</span>
            <div class="chaos__body">
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="chaos__stage" aria-hidden="true">
        {s.frags.map((f, i) => (
          <span class="frag" data-p={f.p} style={`--x:${POS[i][0]};--y:${POS[i][1]};--r:${POS[i][2]}deg;--k:${i}`}>
            <span class:list={['frag__in', `frag--${f.kind}`]}>
              {f.kind === 'msg' && <Icon name="chat" size={14} stroke={1.8} />}
              {f.kind === 'file' && <span class:list={['frag__file', f.text.endsWith('.pdf') && 'frag__file--pdf']}>{f.text.endsWith('.pdf') ? 'P' : 'X'}</span>}
              {f.kind === 'warn' && <span class="pulse"></span>}
              <span class="frag__t">{f.text}</span>
            </span>
          </span>
        ))}
        <div class="chaos__mark">
          <span class="chaos__glow"></span>
          <img src={xMint.src} width="71" height="58" alt="" />
          <span class="chaos__order">{s.order}</span>
        </div>
      </div>
    </div>

    <a class="pb-cta" href={s.solveLink.href} data-reveal>
      <span class="pb-cta__x" aria-hidden="true"><Icon name="check" size={18} stroke={2.2} /></span>
      <span class="pb-cta__text">{s.cta}</span>
      <span class="pb-cta__link">{s.solveLink.label}<Icon name="arrow" size={18} stroke={1.8} /></span>
    </a>
  </div>
</section>

<script>
  import '../scripts/problem-motion.ts';
</script>
