---
/**
 * Страница «Стоимость» — общая разметка для /pricing/ и /en/pricing/.
 * Тексты — src/content/pricing.ts (ru) и pricing.en.ts (en).
 * Цены — в prices этих же файлов (рубли и доллары); и разметка, и калькулятор (src/scripts/pricing.js) берут их оттуда.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import xMint from '../assets/logo/umbrellacorp-x-mint.svg';
import { pricing } from '../content/pricing';
import { pricingEn } from '../content/pricing.en';
import '../styles/pricing.css';

const en = Astro.currentLocale === 'en';
const t = en ? pricingEn : pricing;
const home = en ? '/en/' : '/';
const self = en ? '/en/pricing/' : '/pricing/';
const pr = t.prices;
// суммы: «350 000 ₽» в рублях и «$4,200» в долларах
const money = (v: number) => (pr.currency === 'USD' ? `$${v.toLocaleString('en-US')}` : `${v.toLocaleString('ru-RU').replace(/\s/g, '\u00a0')}\u00a0₽`);
const ARROW = '<svg class="icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>';
const TIER_YEAR = pr.year;
const TIER_MONTH = pr.month;
const SUP = pr.support;
---
<Base
  preloadImages={[
    { href: '/video/hero-poster.webp', media: '(min-width: 768px)', type: 'image/webp' },
    { href: '/video/hero-poster-mobile.webp', media: '(max-width: 767.98px)', type: 'image/webp' },
  ]}
  title={t.meta.title}
  description={t.meta.description}
>
  <Header current={self} />
  <main id="main">
  <!-- Заголовок -->
  <section class="bg-black p-hero on-dark" aria-labelledby="p-title">
    <!-- видеофон, как на главной (декоративный; запускает main.ts) -->
    <div class="hero__video" aria-hidden="true">
      <video class="hero__video-el" muted loop playsinline preload="none" disablepictureinpicture disableremoteplayback tabindex="-1"
        data-hero-video data-src-desktop="/video/hero-desktop.mp4" data-src-mobile="/video/hero-mobile.mp4"></video>
      <div class="hero__shade"></div>
    </div>
    <div class="container p-hero__grid">
      <div>
        <div class="pill-badge hero-anim" style="--d:80">
          <svg viewBox="0 0 107.57 107.58" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M 78.75 42.39 C 75.5 47.72 66.99 51.26 57.47 51.26 L 73.29 25.39 L 89.16 25.39 Z M 73.29 83.15 L 61.13 63.26 C 59.73 60.99 56.9 59.56 53.79 59.56 C 50.68 59.56 47.83 60.99 46.44 63.26 L 34.28 83.15 L 18.42 83.15 L 28.82 66.15 C 32.08 60.83 40.59 57.27 50.1 57.27 L 57.47 57.27 C 66.99 57.27 75.5 60.83 78.75 66.15 L 89.16 83.15 Z M 34.28 25.39 L 50.1 51.26 C 40.59 51.26 32.08 47.72 28.82 42.39 L 18.42 25.39 Z M 78.5 0 L 29.07 0 C 13.01 0 0 13.02 0 29.08 L 0 78.5 C 0 94.55 13.01 107.58 29.07 107.58 L 78.5 107.58 C 94.56 107.58 107.57 94.55 107.57 78.5 L 107.57 29.08 C 107.57 13.02 94.56 0 78.5 0 Z"></path></svg>
          <span>{t.hero.badge}</span>
        </div>
        <h1 class="h1" id="p-title">
          {t.hero.title.map((line, i) => (
            <Fragment>
              {i > 0 && <br />}
              <span class="h1-line"><span style={`--d:${160 + i * 100}`}>{line.map((part) => (part.mint ? <span class="mint">{part.t}</span> : part.t))}</span></span>
            </Fragment>
          ))}
        </h1>
        <p class="p-hero__lead hero-anim" style="--d:480">{t.hero.lead}</p>
        <div class="p-hero__chips hero-anim" style="--d:580">
          <span class="chip"><span class="dot dot--live"></span>{t.hero.chips.platform}</span>
          <span class="chip">{t.hero.chips.impl[0]} <b>{t.hero.chips.impl[1]}</b></span>
          <span class="chip">{t.hero.chips.vat[0]} <b>{t.hero.chips.vat[1]}</b></span>
        </div>
      </div>

      <div class="hero-anim" style="--d:520">
        <div class="ticket" aria-label={t.hero.ticket.aria}>
          <div class="ticket__top">
            <div class="ticket__co"><span class="ticket__av">{t.hero.ticket.avatar}</span><div>{t.hero.ticket.company}<small>{t.hero.ticket.companySub}</small></div></div>
            <span class="status status--mint">26–60</span>
          </div>
          <div class="label">{t.hero.ticket.users}</div>
          <div class="dots" data-dots="120" data-on="48" aria-hidden="true"></div>
          <div class="scale" aria-hidden="true"><span>25</span><span>60</span><span>120</span></div>
          <div class="ticket__sum"><span>{t.hero.ticket.sum}</span><b class="num" data-count={TIER_YEAR[1]}>{money(TIER_YEAR[1])}</b></div>
          <div class="ticket__float"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{t.hero.ticket.free}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Полосы -->
  <section class="section bg-light on-light" id="tiers" aria-labelledby="tiers-title">
    <div class="container">
      <div class="sec-head">
        <div class="sec-head__title" data-reveal>
          <div class="eyebrow">{t.tiers.eyebrow}</div>
          <h2 class="h2" id="tiers-title">{t.tiers.title[0]}<br /> {t.tiers.title[1]}</h2>
        </div>
        <p class="lead" data-reveal style="--i:1">{t.tiers.lead}</p>
      </div>

      <div class="tiers">
        {t.tiers.items.map((it, i) => {
          const hit = i === 1;
          return (
            <article class:list={['card tier lift', hit && 'card--dark tier--hit on-dark']} data-reveal style={`--i:${i}`}>
              <div class="tier__head">
                <div class="label" style={hit ? 'color:var(--c2)' : undefined}>{it.label}</div>
                {hit
                  ? <span class="status status--mint"><span class="dot dot--live"></span>{t.tiers.hitBadge}</span>
                  : <span class="tag tag--line">{it.tag}</span>}
              </div>
              <div class="dots" data-dots="120" data-on={[25, 60, 120][i]} aria-hidden="true"></div>
              <div class="tier__price"><span class="tier__sum num" data-count={TIER_YEAR[i]}>{money(TIER_YEAR[i])}</span><span class="tier__per">{t.tiers.perYear}</span></div>
              <span class="status status--line tier__month" style={hit ? 'border-color:var(--ln-4);color:var(--dk-2)' : undefined} data-count={TIER_MONTH[i]} data-suf={t.tiers.perMonth}>{money(TIER_MONTH[i])}{t.tiers.perMonth}</span>
              <p class="tier__text">{it.text}</p>
            </article>
          );
        })}
      </div>

      <div class="card more" data-reveal>
        <div class="more__l">
          <span class="tag tag--black">120+</span>
          <p><strong style="font-weight:500">{t.tiers.more.strong}</strong> <span>{t.tiers.more.rest}</span></p>
        </div>
        <a class="btn btn--dark btn--md" href="#calc">{t.tiers.more.btn}<Fragment set:html={ARROW} /></a>
      </div>

      <div class="incl" data-reveal>
        <div class="eyebrow">{t.tiers.inclTitle}</div>
        <div class="incl__chips">
          {t.tiers.incl.map((x) => <span class="chip"><span class="ico" data-check></span>{x}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Калькулятор -->
  <section class="section bg-white on-light" id="calc" aria-labelledby="calc-title">
    <div class="container">
      <div class="sec-head">
        <div class="sec-head__title" data-reveal>
          <div class="eyebrow">{t.calc.eyebrow}</div>
          <h2 class="h2" id="calc-title">{t.calc.title[0]}<br /> {t.calc.title[1]}</h2>
        </div>
        <p class="lead" data-reveal style="--i:1">{t.calc.lead}</p>
      </div>

      <div class="calc on-dark" data-reveal data-calc>
        <div class="calc__ctl">
          <div class="field">
            <div class="field__top"><label for="c-users">{t.calc.users}</label><output class="field__val num" for="c-users" data-out-users>48</output></div>
            <input class="range" id="c-users" type="range" min="5" max="200" step="1" value="48" data-users />
            <div class="scale" aria-hidden="true" style="grid-template-columns:20fr 35fr 60fr 80fr"><span>5</span><span>25</span><span>60</span><span>120+</span></div>
          </div>
          <div class="row2">
            <div class="field">
              <div class="field__lbl" id="c-ent-l" style="margin-bottom:12px">{t.calc.entities}</div>
              <div class="stepper" role="group" aria-labelledby="c-ent-l">
                <button type="button" aria-label={t.calc.less} data-ent="-1">−</button>
                <output class="num" data-out-ent>1</output>
                <button type="button" aria-label={t.calc.more} data-ent="1">+</button>
              </div>
            </div>
            <div class="field">
              <div class="field__lbl" id="c-pay-l" style="margin-bottom:12px">{t.calc.pay}</div>
              <div class="seg" role="group" aria-labelledby="c-pay-l" data-pay>
                <button type="button" aria-pressed="true" data-v="year">{t.calc.payYear}</button>
                <button type="button" aria-pressed="false" data-v="quarter">{t.calc.payQuarter} <small>+15%</small></button>
              </div>
            </div>
          </div>
          <label class="switch"><input type="checkbox" data-support /><span class="switch__t"></span><span>{t.calc.support}</span></label>
        </div>

        <div class="calc__res" data-res aria-live="polite">
          <div class="res__tier"><div class="label" data-res-label>{t.calc.resLabel}</div><span class="status status--mint" data-res-users>{t.calc.resUsers}</span></div>
          <div class="dots" data-dots="120" data-on="48" data-live aria-hidden="true"></div>
          <div class="res__total"><b class="num" data-res-total>{money(TIER_YEAR[1] + pr.impl)}</b><span>{t.calc.total}</span></div>
          <ul class="res__rows">
            <li><span data-res-sub-l>{t.calc.rowSub}</span><b class="num" data-res-sub>{money(TIER_YEAR[1])}</b></li>
            <li data-row-ent hidden><span data-res-ent-l>{t.calc.rowEnt}</span><b class="num" data-res-ent>{money(0)}</b></li>
            <li data-row-sup hidden><span>{t.calc.rowSup}</span><b class="num" data-res-sup>{money(0)}</b></li>
            <li><span>{t.calc.rowImpl}</span><b class="num" data-res-impl>{money(pr.impl)}</b></li>
          </ul>
          <p class="res__note" data-res-note>{t.calc.note}</p>
          <p class="res__custom">{t.calc.custom}</p>
          <a class="btn btn--primary btn--md res__cta" href={`${home}#demo`}>{t.calc.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Внедрение и дополнительно -->
  <section class="section bg-light on-light" id="extras" aria-labelledby="extras-title">
    <div class="container">
      <div class="sec-head">
        <div class="sec-head__title" data-reveal>
          <div class="eyebrow">{t.extras.eyebrow}</div>
          <h2 class="h2" id="extras-title">{t.extras.title[0]}<br /> {t.extras.title[1]}</h2>
        </div>
        <p class="lead" data-reveal style="--i:1">{t.extras.lead}</p>
      </div>

      <div class="card impl" data-reveal>
        <div>
          <div class="label">{t.extras.impl.label}</div>
          <div class="impl__sum num" data-count={pr.impl}>{money(pr.impl)}</div>
          <div class="impl__tags">
            {t.extras.impl.tags.map((x, i) => <span class:list={['status', i === 0 ? 'status--mint' : 'status--line']}>{x}</span>)}
          </div>
        </div>
        <div class="impl__body">
          <p>{t.extras.impl.text}</p>
          <div class="tl" data-tl>
            <div class="tl__weeks" aria-hidden="true">{t.extras.impl.weeks.map((w) => <span>{w}</span>)}</div>
            <div class="tl__bar"><span class="tl__fill"></span></div>
            <ol class="tl__steps">
              {t.extras.impl.steps.map((st, i) => <li style={`--i:${i}`}><b>{st.b}</b>{st.t}</li>)}
            </ol>
          </div>
          <p class="muted">{t.extras.impl.note}</p>
        </div>
      </div>

      <div class="incl" data-reveal style="margin-top:clamp(40px,28px + 3vw,64px)">
        <div class="eyebrow">{t.extras.addTitle}</div>
      </div>
      <div class="addons">

        <!-- Сопровождение -->
        <article class="card card--dark addon on-dark" data-reveal style="--i:0" data-support-card>
          <div class="mgr">
            <div class="mgr__who"><span class="mgr__av">{t.extras.support.avatar}</span><div><b>{t.extras.support.who}</b><small>{t.extras.support.whoSub}</small></div></div>
            <span class="status status--mint" style="background:#22f2cf26;color:var(--c2)"><span class="dot dot--live"></span>{t.extras.support.online}</span>
          </div>
          <div class="mgr__msg">{t.extras.support.msg} <b>{t.extras.support.msgB}</b></div>
          <div class="mgr__typing" aria-hidden="true"><i style="--k:0"></i><i style="--k:1"></i><i style="--k:2"></i></div>

          <h3>{t.extras.support.title}</h3>
          <p class="addon__lead">{t.extras.support.lead}</p>

          <div class="pricebox">
            <div class="seg" role="group" aria-label={t.extras.support.segAria} data-sup-seg>
              {t.extras.support.segs.map((s, i) => <button type="button" aria-pressed={String(i === 1)} data-v={SUP[i]}>{s}</button>)}
            </div>
            <div class="pricebox__v"><b class="num" data-sup-price>{money(SUP[1])}</b><span>{t.extras.support.perMonth}</span></div>
          </div>

          <div class="sla">
            <div class="sla__i"><b>{t.extras.support.sla[0].b}</b><span>{t.extras.support.sla[0].s}</span></div>
            <div class="sla__i sla__i--hot"><b><span class="dot dot--live"></span>{t.extras.support.sla[1].b}</b><span>{t.extras.support.sla[1].s}</span></div>
          </div>
          <div class="hrs" data-hrs>
            <div class="hrs__top"><span>{t.extras.support.hrs}</span><b data-count="6" data-fmt="int" data-suf={t.extras.support.hrsSuf}>6{t.extras.support.hrsSuf}</b></div>
            <div class="hrs__bar" aria-hidden="true"><i style="--k:0"></i><i style="--k:1"></i><i style="--k:2"></i><i style="--k:3"></i><i style="--k:4"></i><i style="--k:5"></i></div>
            <div class="hrs__m" aria-hidden="true">{t.extras.support.hrsMonths.map((m) => <span>{m}</span>)}</div>
          </div>
          <ul class="ticks">
            {t.extras.support.ticks.map((x) => <li><span class="ico" data-check></span>{x}</li>)}
          </ul>
        </article>

        <!-- Доработки -->
        <article class="card addon" data-reveal style="--i:1">
          <span class="tag tag--mint" style="align-self:flex-start">{t.extras.dev.tag}</span>
          <div class="layers" aria-hidden="true">
            <div class="layer layer--you">{t.extras.dev.you} <small>{t.extras.dev.youSub}</small></div>
            <div class="layer layer--base">{t.extras.dev.base} <small>{t.extras.dev.baseSub}</small></div>
            <svg class="layers__arrow" viewBox="0 0 22 110" fill="none"><path d="M11 106V8" stroke="currentColor" stroke-width="2"/><path d="M4 15l7-8 7 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke-dasharray:none;animation:none"/></svg>
          </div>
          <h3>{t.extras.dev.title}</h3>
          <p class="addon__lead">{t.extras.dev.lead}</p>
          <div class="rate">
            <span class="rate__big"><b class="num" data-count={pr.rate}>{money(pr.rate)}</b><span>{t.extras.dev.rateSuf}</span></span>
            <span class="status status--line">{t.extras.dev.min}</span>
          </div>
          <ul class="menu">
            {t.extras.dev.menu.map((m) => (
              <li><span class="menu__n">{m.n}</span><span class="menu__dots"></span><span class="menu__p" data-count={m.v} data-pre={t.extras.dev.from}>{t.extras.dev.from}{money(m.v)}</span></li>
            ))}
          </ul>
          <div class="estimate">
            <div class="estimate__in">
              <span class="ico" data-check style="background:#22f2cf26"></span>
              <p><b>{t.extras.dev.estimateB}</b>{t.extras.dev.estimate}</p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Оплата -->
  <section class="section bg-white on-light" id="payment" aria-labelledby="pay-title">
    <div class="container">
      <div class="sec-head">
        <div class="sec-head__title" data-reveal>
          <div class="eyebrow">{t.pay.eyebrow}</div>
          <h2 class="h2" id="pay-title">{t.pay.title[0]}<br /> {t.pay.title[1]}</h2>
        </div>
        <p class="lead" data-reveal style="--i:1">{t.pay.lead}</p>
      </div>

      <div class="plan" data-reveal data-plan>
        <div>
          <div class="opts" role="radiogroup" aria-label={t.pay.optsAria}>
            {t.pay.opts.map((o, i) => (
              <button type="button" class="opt" role="radio" aria-checked={String(i === 0)} data-mode={['year', 'quarter', 'two'][i]}>
                <span class="opt__r"></span><span class="opt__t">{o.t}</span><span class="opt__k">{['×1', '+15%', '0%'][i]}</span>
                <span class="opt__d">{o.d}</span>
              </button>
            ))}
          </div>
          <div class="opts__tier">
            <span class="field__lbl" id="plan-tier-l">{t.pay.tier}</span>
            <div class="seg seg--light" role="group" aria-labelledby="plan-tier-l" data-plan-tier>
              {t.pay.tiers.map((s, i) => <button type="button" aria-pressed={String(i === 1)} data-v={i}>{s}</button>)}
            </div>
          </div>
        </div>

        <div class="sched on-dark" aria-live="polite">
          <div class="sched__top">
            <div class="sched__sum">
              <div class="label" data-plan-cap>{t.pay.cap}</div>
              <b class="num" data-plan-sum>{money(TIER_YEAR[1])}</b>
              <small data-plan-sub>{t.pay.sub}</small>
            </div>
            <span class="status status--mint sched__badge" style="background:#22f2cf26;color:var(--c2)" data-plan-badge>{t.pay.badge}</span>
          </div>
          <div class="bars" data-bars aria-hidden="true"></div>
          <div class="months" data-months aria-hidden="true"></div>
          <div class="sched__foot">
            <span class="status">{t.pay.total} <b class="num" data-plan-total>{money(TIER_YEAR[1])}</b></span>
            <span class="status" data-plan-month>{t.pay.month[0]} <b class="num" data-plan-mb>{money(Math.round(TIER_YEAR[1] / 12))}</b> {t.pay.month[1]}</span>
          </div>
        </div>
      </div>

      <div class="terms" data-reveal>
        <div class="term">
          <div class="term__k"><span class="mint" data-count="20" data-fmt="int" data-pre="+" data-suf="">+20</span>%</div>
          <div class="term__t">{t.pay.terms[0].t}</div>
          <p class="term__d">{t.pay.terms[0].d}</p>
        </div>
        <div class="term">
          <div class="term__k"><span data-count="100" data-fmt="int" data-suf="">100</span><span class="mint">%</span></div>
          <div class="term__t">{t.pay.terms[1].t}</div>
          <p class="term__d">{t.pay.terms[1].d}</p>
        </div>
        <div class="term">
          <div class="term__k">{t.pay.terms[2].k![0]}<span class="mint">{t.pay.terms[2].k![1]}</span></div>
          <div class="term__t">{t.pay.terms[2].t}</div>
          <p class="term__d">{t.pay.terms[2].d}</p>
        </div>
      </div>
    </div>
  </section>
  <!-- Призыв -->
  <section class="demo-sec bg-white" id="raschet" aria-labelledby="demo-title">
    <div class="container">
      <div class="demo" data-reveal>
        <div class="demo__bg" aria-hidden="true"><img class="demo__x" src={xMint.src} width="70" height="58" alt="" /></div>
        <div class="demo__shade" aria-hidden="true"></div>
        <div class="demo__inner">
          <div class="demo__copy">
            <div class="demo__label">{t.demo.label}</div>
            <h2 class="demo__slogan" id="demo-title">{t.demo.title[0]}<br />{t.demo.title[1]}</h2>
            <p class="demo__text">{t.demo.text}</p>
          </div>
          <div class="demo__side">
            <div class="demo__actions">
              <a class="btn btn--primary btn--lg" href={`${home}#demo`}>{t.demo.primary}</a>
              <a class="btn btn--onDark btn--lg" href="#calc">{t.demo.secondary}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  </main>
  <Footer />
  <!-- строки для калькулятора и графика оплаты (src/scripts/pricing.js) -->
  <script type="application/json" id="pricing-i18n" set:html={JSON.stringify({ ...t.js, prices: pr })}></script>
  <script>
    import '../scripts/main.ts';
    import '../scripts/pricing.js';
    import '../scripts/pricing-motion.js';
  </script>
</Base>
